rules_version = '2';
// Skor Yazarları — güvenli kurallar
// Herkes okur. Sadece yönetici yazar. Yazarlar yalnızca kendi tahminlerini,
// hafta yayınlanmadığı sürece girebilir (maç saati tahmini kapatmaz).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@skoryazarlari.app';
    }
    function weekDoc(s, w) {
      return get(/databases/$(database)/documents/seasons/$(s)/weeks/$(w)).data;
    }
    function weekOpen(s, w) {
      return weekDoc(s, w).get('isPublished', false) != true;
    }

    match /users/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    match /integrations/{id} { allow read, write: if isAdmin(); }

    match /seasons/{s} {
      allow read: if true;
      allow write: if isAdmin();

      match /weeks/{w} {
        allow read: if true;
        allow write: if isAdmin();

        match /matches/{m} { allow read: if true; allow write: if isAdmin(); }

        match /submissions/{u} {
          allow read: if true;
          allow create, update: if isAdmin() || weekOpen(s, w);
          allow delete: if isAdmin();
        }
      }

      match /weekPoints/{w}/{rest=**} { allow read: if true; allow write: if isAdmin(); }
      match /weekPoints/{w} { allow read: if true; allow write: if isAdmin(); }

      match /predictions/{p} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin() || weekOpen(s, request.resource.data.weekId);
      }
    }
  }
}
