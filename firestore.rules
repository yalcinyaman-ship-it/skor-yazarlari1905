rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function incoming() {
      return request.resource.data;
    }

    function isSafeScore(score) {
      return score is number && score >= 0 && score <= 30;
    }

    function isValidPrediction(data) {
      return data.keys().hasAll([
        'userId',
        'weekId',
        'matchId',
        'predictedHome',
        'predictedAway',
        'createdAt'
      ]) &&
      data.keys().size() == 6 &&
      data.userId is string &&
      data.weekId is string &&
      data.matchId is string &&
      isSafeScore(data.predictedHome) &&
      isSafeScore(data.predictedAway);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if true;

      match /weeks/{weekId} {
        allow read: if true;
        allow write: if true;

        match /matches/{matchId} {
          allow read: if true;
          allow write: if true;
        }
      }

      match /predictions/{predictionId} {
        allow read: if true;
        allow create: if isValidPrediction(incoming());
        allow update, delete: if true;
      }

      match /weekPoints/{weekId}/userPoints/{userId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}